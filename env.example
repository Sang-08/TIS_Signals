# ===== BẮT BUỘC — Điền rồi đổi tên thành .env =====

# Token bot Telegram — lấy từ @BotFather (dạng: 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
TELEGRAM_BOT_TOKEN=

# API key Finnhub (free) — lấy tại https://finnhub.io/register
FINNHUB_API_KEY=

# ===== DATABASE — PostgreSQL =====

# Connection string PostgreSQL
# Dạng: postgresql://user:password@host:port/database_name
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/Trading Intelligence System

# ===== WATCHLIST =====

# Cặp forex theo dõi (định dạng OANDA)
WATCHLIST=OANDA:EUR_USD,OANDA:GBP_USD,OANDA:USD_JPY,OANDA:USD_CHF,OANDA:AUD_USD,OANDA:USD_CAD,OANDA:NZD_USD

# Crypto symbols (Binance Futures)
CRYPTO_WATCHLIST=BTCUSDT,ETHUSDT

# ===== CẢNH BÁO BIẾN ĐỘNG =====

# Khoảng thời gian gửi cập nhật định kỳ cho subscriber (giây)
ALERT_INTERVAL_SECONDS=3600

# Ngưỡng % thay đổi giá forex để gửi cảnh báo đột biến
ALERT_THRESHOLD_PERCENT=0.5

# Ngưỡng funding rate cực đoan (%)
ALERT_FUNDING_THRESHOLD=0.1

# Ngưỡng OI thay đổi đột biến (%)
ALERT_OI_THRESHOLD=5.0

# Ngưỡng whale transaction khổng lồ (USD)
ALERT_WHALE_USD=50000000

# Tần suất kiểm tra biến động (giây) — mặc định 120s
ALERT_CHECK_INTERVAL=120

# ===== TÙY CHỌN =====

# Whale Alert API key — https://whale-alert.io/
# Để trống = /whale sẽ báo hướng dẫn
WHALE_ALERT_API_KEY=

# Port cho API server + Dashboard
API_PORT=8877
